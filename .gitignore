# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code: personal settings and per-session hook state (SDD template)
.claude/settings.local.json
.claude/.sdd-session/

# Temporary context tooling (SDD template)
.context-cache/

# Listing kit: raw captures and host logs, rebuilt by npm run listing:capture (F-010)
/.listing-cache/

# Listing kit run tests write a temporary project here and delete it; never commit one left by a crash
/scripts/listing/projects/_guard-test-*.mjs
